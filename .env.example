# Legal Powerhouse Environment Variables
# All secrets stored in Supabase vault, loaded at runtime

# Supabase (use your actual values)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
